<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.facecontext"
    android:versionCode="1"
    android:versionName="0.1-alpha">

    <!-- ── PERMISSIONS ─────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- ── HARDWARE: Rokid has NO touchscreen ──────────────────── -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="false" />

    <!-- Camera required (facial recognition) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Microphone required (speech-to-text capture) -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:label="FaceContext"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.FaceContext"
        android:hardwareAccelerated="true">

        <!-- Main HUD Activity — fullscreen, portrait locked to 480x640 -->
        <activity
            android:name=".HUDActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:theme="@style/Theme.FaceContext.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Capture Service — background Camera2 + mic pipeline -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

    </application>

</manifest>
