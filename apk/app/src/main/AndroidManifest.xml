<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.facecontext"
    android:versionCode="1"
    android:versionName="0.1-alpha">

    <!-- ── PERMISSIONS ─────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- ── HARDWARE: Rokid has NO touchscreen ──────────────────── -->
    <uses-feature android:name="android.hardware.touchscreen"            android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch" android:required="false" />
    <uses-feature android:name="android.hardware.camera"                 android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus"       android:required="false" />
    <uses-feature android:name="android.hardware.microphone"             android:required="true" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.FaceContext"
        android:hardwareAccelerated="true">

        <!--
        ══════════════════════════════════════════════════════════════
          HUDActivity — entry point
          Aparece no menu principal do Rokid YodaOS como um app nativo
          via categoria "rokid.intent.category.LAUNCHER" + ícone/label
        ══════════════════════════════════════════════════════════════
        -->
        <activity
            android:name=".HUDActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:theme="@style/Theme.FaceContext.Fullscreen"
            android:launchMode="singleTask">

            <!-- Android standard launcher (ADB, Android Studio, sideload) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Rokid YodaOS menu launcher
                Esta categoria faz o app aparecer no menu principal dos óculos
                junto com Tradução, Teleprompter, Reconhecimento de Objetos etc.

                Metadados adicionais controlam o ícone e a posição no menu.
                O ícone deve estar em res/drawable/ic_launcher.png (72×72 px,
                fundo transparente, arte branca/verde para contraste no waveguide).
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="rokid.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Alternativamente (Rokid SDK mais recente usa esta action):
                Alguns firmwares YodaOS reconhecem "com.rokid.intent.action.ROKID_APP"
            -->
            <intent-filter>
                <action android:name="com.rokid.intent.action.ROKID_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- Capture Service — Camera2 + mic em foreground -->
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

    </application>

</manifest>
